rules_version = '2';

/**
 * ==============================================================================
 * FIRESTORE SECURITY RULES - LM TEAM ASSESSORIA ESPORTIVA & MÉDICA
 * ==============================================================================
 *
 * ARQUITETURA DE SEGURANÇA ZERO-TRUST COM CONTROLE BASEADO EM PAPÉIS (RBAC/ABAC):
 * 1. Autenticação Obrigatória em Todas as Regras: Nenhum acesso público/anônimo é permitido.
 * 2. Perfis em /users/{uid} com papéis estritos: athlete | coach | nutritionist | doctor | admin.
 * 3. Isolamento Total de Atletas: Cada atleta acessa exclusivamente seus próprios dados de saúde.
 * 4. Acesso Profissional Vinculado: Profissionais só acessam atletas explicitamente atribuídos.
 * 5. Proteção de Governança: Somente administradores criam/removem profissionais e alteram papéis.
 * 6. Imutabilidade e Anti-Privilege Escalation: Bloqueio de elevação de privilégios pelo cliente.
 * 7. Sem fallbacks permissivos (match /{document=**} allow read, write: if false).
 */

service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================================================
    // 1. FUNÇÕES AUXILIARES GLOBAIS DE SEGURANÇA E IDENTIDADE
    // ==========================================================================

    /// Verifica se o usuário está autenticado no Firebase Authentication
    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    /// Atalho para dados da requisição de entrada
    function incoming() {
      return request.resource.data;
    }

    /// Atalho para dados existentes no documento
    function existing() {
      return resource.data;
    }

    /// Validação estrita de formato e tamanho de IDs para prevenir injeção (ID Poisoning)
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-\\.]+$');
    }

    /// Verifica se o documento de perfil /users/{uid} existe para o usuário autenticado
    function hasUserDoc() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    /// Obtém os dados do documento /users/{uid}
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    /// Retorna o role do usuário autenticado ou 'none'
    function getUserRole() {
      return hasUserDoc() && getUserData().role is string ? getUserData().role : 'none';
    }

    /// Verifica se o usuário é Administrador Geral do Sistema
    /// FONTE CENTRALIZADA DE AUTORIZAÇÃO: Registro em /admins/{uid}, /users/{uid} (role=admin e isAdmin=true)
    /// ou Custom Claim 'admin' emitido pelo Admin SDK.
    /// NUNCA concede privilégios automaticamente por endereço de e-mail.
    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (hasUserDoc() && getUserData().role == 'admin' && getUserData().isAdmin == true) ||
        (request.auth.token.get('admin', false) == true)
      );
    }

    /// Verifica se o usuário é Coach / Treinador
    function isCoach() {
      return isSignedIn() && (getUserRole() == 'coach' || isAdmin());
    }

    /// Verifica se o usuário é Nutricionista
    function isNutritionist() {
      return isSignedIn() && (getUserRole() == 'nutritionist' || isAdmin());
    }

    /// Verifica se o usuário é Médico do Esporte / Endocrinologista
    function isDoctor() {
      return isSignedIn() && (getUserRole() == 'doctor' || isAdmin());
    }

    /// Verifica se o usuário é qualquer Profissional de Saúde/Esporte ou Admin
    function isProfessional() {
      return isCoach() || isNutritionist() || isDoctor() || isAdmin();
    }

    /// Verifica se o usuário autenticado é o próprio Atleta dono do registro
    function isAthleteOwner(athleteId) {
      return isSignedIn() && (
        request.auth.uid == athleteId ||
        (hasUserDoc() && getUserData().athleteId == athleteId)
      );
    }

    /// Verifica se o usuário autenticado é o Prescritor dono do registro
    function isPrescriberOwner(prescriberId) {
      return isSignedIn() && (
        request.auth.uid == prescriberId ||
        (hasUserDoc() && getUserData().prescriberId == prescriberId)
      );
    }

    /// Verifica se o profissional autenticado está explicitamente vinculado ao Atleta
    function isLinkedProfessional(athleteId) {
      return isSignedIn() && (
        isAdmin() ||
        (isProfessional() && (
          // 1. Verificação na lista assignedAthleteIds do profissional
          (hasUserDoc() && getUserData().assignedAthleteIds is list && athleteId in getUserData().assignedAthleteIds) ||
          // 2. Verificação nos campos diretos do documento do atleta
          (exists(/databases/$(database)/documents/athletes/$(athleteId)) && (
            get(/databases/$(database)/documents/athletes/$(athleteId)).data.coachId == request.auth.uid ||
            get(/databases/$(database)/documents/athletes/$(athleteId)).data.nutritionistId == request.auth.uid ||
            get(/databases/$(database)/documents/athletes/$(athleteId)).data.doctorId == request.auth.uid ||
            (get(/databases/$(database)/documents/athletes/$(athleteId)).data.assignedPrescriberIds is list &&
             get(/databases/$(database)/documents/athletes/$(athleteId)).data.assignedPrescriberIds.hasAny([request.auth.uid]))
          ))
        ))
      );
    }

    /// Verifica se o coach autenticado está explicitamente vinculado ao Atleta
    function isLinkedCoach(athleteId) {
      return isSignedIn() && (
        isAdmin() ||
        (isCoach() && (
          // 1. Verificação na lista assignedAthleteIds do usuário coach
          (hasUserDoc() && getUserData().assignedAthleteIds is list && athleteId in getUserData().assignedAthleteIds) ||
          // 2. Verificação nos campos diretos do atleta (coachId ou assignedPrescriberIds)
          (exists(/databases/$(database)/documents/athletes/$(athleteId)) && (
            get(/databases/$(database)/documents/athletes/$(athleteId)).data.coachId == request.auth.uid ||
            (get(/databases/$(database)/documents/athletes/$(athleteId)).data.assignedPrescriberIds is list &&
             get(/databases/$(database)/documents/athletes/$(athleteId)).data.assignedPrescriberIds.hasAny([request.auth.uid]))
          ))
        ))
      );
    }

    /// Verifica se o nutricionista autenticado está explicitamente vinculado ao Atleta
    function isLinkedNutritionist(athleteId) {
      return isSignedIn() && (
        isAdmin() ||
        (isNutritionist() && (
          // 1. Verificação na lista assignedAthleteIds do usuário nutricionista
          (hasUserDoc() && getUserData().assignedAthleteIds is list && athleteId in getUserData().assignedAthleteIds) ||
          // 2. Verificação nos campos diretos do atleta (nutritionistId ou assignedPrescriberIds)
          (exists(/databases/$(database)/documents/athletes/$(athleteId)) && (
            get(/databases/$(database)/documents/athletes/$(athleteId)).data.nutritionistId == request.auth.uid ||
            (get(/databases/$(database)/documents/athletes/$(athleteId)).data.assignedPrescriberIds is list &&
             get(/databases/$(database)/documents/athletes/$(athleteId)).data.assignedPrescriberIds.hasAny([request.auth.uid]))
          ))
        ))
      );
    }

    /// Verifica se o médico ou nutricionista autenticado está vinculado ao Atleta para manipulados/suplementação
    function isLinkedSupplementPrescriber(athleteId) {
      return isSignedIn() && (
        isAdmin() ||
        ((isDoctor() || isNutritionist()) && (
          // 1. Verificação na lista assignedAthleteIds do prescritor
          (hasUserDoc() && getUserData().assignedAthleteIds is list && athleteId in getUserData().assignedAthleteIds) ||
          // 2. Verificação nos campos diretos do atleta (doctorId, nutritionistId ou assignedPrescriberIds)
          (exists(/databases/$(database)/documents/athletes/$(athleteId)) && (
            get(/databases/$(database)/documents/athletes/$(athleteId)).data.doctorId == request.auth.uid ||
            get(/databases/$(database)/documents/athletes/$(athleteId)).data.nutritionistId == request.auth.uid ||
            (get(/databases/$(database)/documents/athletes/$(athleteId)).data.assignedPrescriberIds is list &&
             get(/databases/$(database)/documents/athletes/$(athleteId)).data.assignedPrescriberIds.hasAny([request.auth.uid]))
          ))
        ))
      );
    }

    /// Valida acesso estrito por modalidade de prescrição (workouts, nutrition, supplements)
    /// Garante que somente profissionais com papel compatível e vínculo ativo possam acessar/modificar
    function canAccessPrescriptionModality(prescriptionType, athleteId, isWrite) {
      return prescriptionType == 'workouts'
        ? (isWrite ? isLinkedCoach(athleteId) : (isAthleteOwner(athleteId) || isLinkedCoach(athleteId)))
        : prescriptionType == 'nutrition'
        ? (isWrite ? isLinkedNutritionist(athleteId) : (isAthleteOwner(athleteId) || isLinkedNutritionist(athleteId)))
        : prescriptionType == 'supplements'
        ? (isWrite ? isLinkedSupplementPrescriber(athleteId) : (isAthleteOwner(athleteId) || isLinkedSupplementPrescriber(athleteId)))
        : isAdmin();
    }

    // ==========================================================================
    // 2. REGRAS PARA PERFIS DE USUÁRIO: /users/{userId}
    // ==========================================================================
    match /users/{userId} {
      // Leitura: O próprio usuário, Administrador ou profissional vinculado ao atleta
      allow get: if isSignedIn() && (
        request.auth.uid == userId ||
        isAdmin() ||
        isLinkedProfessional(userId)
      );

      // Listagem: Apenas Administradores
      allow list: if isAdmin();

      // Criação de perfil (Autocadastro com Lista Explícita de Campos Permitidos):
      // - Administrador pode criar qualquer perfil
      // - Usuário novo autenticado pode criar APENAS seu próprio perfil com role 'athlete'
      // - PROÍBE expressamente: isAdmin, isMaster, athleteId, prescriberId e assignedAthleteIds fornecidos livremente pelo usuário
      // - Vínculos e privilégios devem ser definidos APENAS por operação administrativa autorizada
      allow create: if isSignedIn() && isValidId(userId) && (
        isAdmin() ||
        (
          request.auth.uid == userId &&
          incoming().id == userId &&
          incoming().email is string &&
          incoming().role == 'athlete' &&
          // Proíbe campos de privilégio e vínculos fornecidos livremente pelo usuário
          !incoming().keys().hasAny([
            'isAdmin', 'isMaster', 'athleteId', 'prescriberId', 'assignedAthleteIds'
          ]) &&
          // Lista explícita de campos permitidos no autocadastro (impede qualquer campo estranho/arbitrário)
          incoming().diff({}).affectedKeys().hasOnly([
            'id', 'email', 'name', 'role', 'status',
            'createdAt', 'updatedAt', 'phone', 'avatar',
            'birthDate', 'cpf', 'bio', 'gender'
          ])
        )
      );

      // Atualização de perfil:
      // - Administrador: atualização irrestrita de roles e atribuições
      // - Próprio usuário: pode atualizar APENAS campos cadastrais não-sensíveis
      // - athleteId REMOVIDO expressamente da lista de campos editáveis pelo próprio usuário
      // - Proíbe expressamente adulteração de privilégios e vínculos
      allow update: if isSignedIn() && (
        isAdmin() ||
        (
          request.auth.uid == userId &&
          // Garante que o role e status não sofram adulteração pelo cliente comum
          incoming().role == existing().role &&
          (!existing().keys().hasAny(['isAdmin']) || incoming().isAdmin == existing().isAdmin) &&
          (!existing().keys().hasAny(['isMaster']) || incoming().isMaster == existing().isMaster) &&
          // Proíbe alteração arbitrária de vínculos e privilégios
          !incoming().diff(existing()).affectedKeys().hasAny([
            'isAdmin', 'isMaster', 'athleteId', 'prescriberId', 'assignedAthleteIds', 'role', 'id', 'email'
          ]) &&
          // Lista explícita de campos editáveis pelo próprio usuário (athleteId REMOVIDO)
          incoming().diff(existing()).affectedKeys().hasOnly([
            'name', 'phone', 'avatar', 'birthDate', 'cpf', 'bio',
            'gender', 'updatedAt', 'accessPassword', 'passwordChangedAt',
            'requiresPasswordChange'
          ])
        )
      );

      // Exclusão: Apenas Administrador
      allow delete: if isAdmin();
    }

    // ==========================================================================
    // 3. REGRAS PARA ATLETAS E DADOS CLÍNICOS / ESPORTIVOS: /athletes/{athleteId}
    // ==========================================================================
    match /athletes/{athleteId} {
      // Leitura: O próprio atleta, Administrador ou profissional de saúde/esporte vinculado
      allow get: if isSignedIn() && (
        isAthleteOwner(athleteId) ||
        isLinkedProfessional(athleteId)
      );

      // Listagem: Restrita estritamente aos vínculos autorizados e Administrador (Zero consulta ampla)
      allow list: if isSignedIn() && (
        isAdmin() ||
        (isProfessional() && (
          resource.data.coachId == request.auth.uid ||
          resource.data.nutritionistId == request.auth.uid ||
          resource.data.doctorId == request.auth.uid ||
          (resource.data.assignedPrescriberIds is list && resource.data.assignedPrescriberIds.hasAny([request.auth.uid]))
        )) ||
        (resource.data.id == request.auth.uid) ||
        (hasUserDoc() && getUserData().athleteId == resource.data.id)
      );

      // Criação: Apenas Administradores e Profissionais da Assessoria
      allow create: if isProfessional() && isValidId(athleteId);

      // Atualização:
      // - Administrador ou Profissional Vinculado: atualização completa de planos e dados clínicos
      // - Próprio Atleta: pode atualizar apenas métricas corporais pessoais e dados cadastrais
      allow update: if isSignedIn() && (
        isAdmin() ||
        isLinkedProfessional(athleteId) ||
        (
          isAthleteOwner(athleteId) &&
          // Bloqueia alteração de coachId, nutritionistId, doctorId ou status pelo atleta
          incoming().status == existing().status &&
          (!existing().keys().hasAny(['coachId']) || incoming().coachId == existing().coachId) &&
          (!existing().keys().hasAny(['nutritionistId']) || incoming().nutritionistId == existing().nutritionistId) &&
          (!existing().keys().hasAny(['doctorId']) || incoming().doctorId == existing().doctorId) &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'name', 'phone', 'avatar', 'currentWeightKg', 'measurementsHistory',
            'adherencePercentage', 'notes', 'updatedAt', 'accessPassword', 'passwordChangedAt'
          ])
        )
      );

      // Exclusão de Atleta: Apenas Administrador
      allow delete: if isAdmin();

      // ------------------------------------------------------------------------
      // SUBCOLEÇÕES DO ATLETA (Check-ins de Treino, Dieta, Suplementos e Antropometria)
      // ------------------------------------------------------------------------
      match /checkins/{checkinId} {
        allow read: if isSignedIn() && (isAthleteOwner(athleteId) || isLinkedProfessional(athleteId));
        allow create, update: if isSignedIn() && (isAthleteOwner(athleteId) || isLinkedProfessional(athleteId));
        allow delete: if isSignedIn() && (isAthleteOwner(athleteId) || isAdmin());
      }

      match /exercise_set_checkins/{checkinId} {
        allow read: if isSignedIn() && (isAthleteOwner(athleteId) || isLinkedProfessional(athleteId));
        allow create, update: if isSignedIn() && (isAthleteOwner(athleteId) || isLinkedProfessional(athleteId));
        allow delete: if isSignedIn() && (isAthleteOwner(athleteId) || isAdmin());
      }

      match /meal_checkins/{checkinId} {
        allow read: if isSignedIn() && (isAthleteOwner(athleteId) || isLinkedProfessional(athleteId));
        allow create, update: if isSignedIn() && (isAthleteOwner(athleteId) || isLinkedProfessional(athleteId));
        allow delete: if isSignedIn() && (isAthleteOwner(athleteId) || isAdmin());
      }

      match /supplement_checkins/{checkinId} {
        allow read: if isSignedIn() && (isAthleteOwner(athleteId) || isLinkedProfessional(athleteId));
        allow create, update: if isSignedIn() && (isAthleteOwner(athleteId) || isLinkedProfessional(athleteId));
        allow delete: if isSignedIn() && (isAthleteOwner(athleteId) || isAdmin());
      }

      match /anthropometric_evaluations/{evalId} {
        allow read: if isSignedIn() && (isAthleteOwner(athleteId) || isLinkedProfessional(athleteId));
        allow create, update: if isSignedIn() && (isAthleteOwner(athleteId) || isLinkedProfessional(athleteId));
        allow delete: if isAdmin() || (isSignedIn() && isAthleteOwner(athleteId));
      }
    }

    // ==========================================================================
    // 4. REGRAS PARA PRESCRIÇÕES OFICIAIS (Treinos, Nutrição e Manipulados)
    // /prescriptions/{prescriptionType}/athletes/{athleteId}
    // ACESSO ESTRITAMENTE VINCULADO E AUTORIZADO POR MODALIDADE (ZERO ACESSO AMPLO)
    // ==========================================================================
    match /prescriptions/{prescriptionType}/athletes/{athleteId} {
      // Leitura: O atleta dono da prescrição (somente-leitura) ou profissional com vínculo e papel na modalidade
      allow get: if isSignedIn() && isValidId(athleteId) && canAccessPrescriptionModality(prescriptionType, athleteId, false);

      // Listagem: Restrita aos vínculos autorizados e admins
      allow list: if isSignedIn() && isValidId(athleteId) && canAccessPrescriptionModality(prescriptionType, athleteId, false);

      // Criação, Edição e Exclusão: Estritamente reservada para o Profissional Vinculado e Autorizado na Modalidade (ou Admin)
      // Atletas são estritamente PROIBIDOS de modificar suas prescrições oficiais
      allow create, update, delete: if isSignedIn() && isValidId(athleteId) && canAccessPrescriptionModality(prescriptionType, athleteId, true);

      // Subcoleções aninhadas sob a prescrição oficial (ex: exercícios, divisões, refeições)
      match /{allSubPaths=**} {
        allow get, list: if isSignedIn() && isValidId(athleteId) && canAccessPrescriptionModality(prescriptionType, athleteId, false);
        allow create, update, delete: if isSignedIn() && isValidId(athleteId) && canAccessPrescriptionModality(prescriptionType, athleteId, true);
      }
    }

    // Bloqueio Total de Acesso Amplo em /prescriptions:
    // Nenhum profissional não vinculado ou desautorizado consegue ler ou modificar por qualquer caminho coincidente
    match /prescriptions/{allPaths=**} {
      allow read, write: if false;
    }

    // ==========================================================================
    // 5. REGRAS PARA O CORPO TÉCNICO / PRESCRITORES: /prescribers/{prescriberId}
    // ==========================================================================
    match /prescribers/{prescriberId} {
      // Leitura: Qualquer usuário autenticado pode ler informações básicas do corpo técnico
      allow read: if isSignedIn();

      // Criação de novos prescritores: Estritamente Administrador
      allow create: if isAdmin() && isValidId(prescriberId);

      // Atualização de dados do prescritor:
      // - Administrador pode alterar tudo (funções, status, privilégios)
      // - O próprio prescritor pode atualizar sua bio, telefone, avatar e senha
      //   (NÃO pode se autopromover a isMaster ou isAdmin nem mudar roleType)
      allow update: if isSignedIn() && (
        isAdmin() ||
        (
          isPrescriberOwner(prescriberId) &&
          incoming().roleType == existing().roleType &&
          (!existing().keys().hasAny(['isMaster']) || incoming().isMaster == existing().isMaster) &&
          (!existing().keys().hasAny(['isAdmin']) || incoming().isAdmin == existing().isAdmin) &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'name', 'phone', 'avatar', 'bio', 'crm_crn_cref',
            'accessPassword', 'passwordChangedAt', 'requiresPasswordChange', 'updatedAt'
          ])
        )
      );

      // Exclusão de prescritor: Estritamente Administrador
      allow delete: if isAdmin();
    }

    // ==========================================================================
    // 6. BANCO DE EXERCÍCIOS OFICIAL: /exercises/{exerciseId}
    // ==========================================================================
    match /exercises/{exerciseId} {
      // Leitura: Todos os usuários autenticados da assessoria (atletas e treinadores)
      allow read: if isSignedIn();

      // Criação e Edição: Apenas Profissionais (Coaches/Admins)
      allow create, update: if isProfessional() && isValidId(exerciseId);

      // Exclusão: Apenas Profissionais e Administradores
      allow delete: if isProfessional();
    }

    // ==========================================================================
    // 7. TEMPLATES E MODELOS (Treinos e Fórmulas): /workout_templates e /formula_templates
    // ==========================================================================
    match /workout_templates/{templateId} {
      allow read: if isSignedIn();
      allow write: if isProfessional() && isValidId(templateId);
    }

    match /formula_templates/{templateId} {
      allow read: if isSignedIn();
      allow write: if isProfessional() && isValidId(templateId);
    }

    // ==========================================================================
    // 8. REGISTRO DE ADMINISTRADORES DO SISTEMA: /admins/{adminId}
    // ==========================================================================
    match /admins/{adminId} {
      allow read, write: if isAdmin();
    }

    // ==========================================================================
    // 9. LOGS DE AUDITORIA DE GOVERNANÇA E SEGURANÇA: /audit_logs/{logId}
    // ==========================================================================
    match /audit_logs/{logId} {
      // Leitura de logs de auditoria: Estritamente Administradores Gerais
      allow read: if isAdmin();
      // Criação de log: Administrador ou backend autenticado
      allow create: if isSignedIn() && (
        isAdmin() ||
        (
          incoming().actorUid == request.auth.uid &&
          incoming().action is string &&
          incoming().resource is string &&
          incoming().resourceId is string
        )
      );
      // Logs são imutáveis (sem update ou delete por nenhum cliente)
      allow update, delete: if false;
    }

    // ==========================================================================
    // 10. DEFAULT DENY GLOBAL CATCH-ALL (Zero-Trust)
    // ==========================================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
